# Public Firebase Web configuration (inspect the current Bundled Notes web app).
BUNDLED_FIREBASE_API_KEY=
BUNDLED_FIREBASE_PROJECT_ID=bundled-7946c
BUNDLED_FIREBASE_STORAGE_BUCKET=bundled-7946c.appspot.com

# Treat this as a password. Obtain it interactively with bundled-notes-bootstrap-auth.
BUNDLED_FIREBASE_REFRESH_TOKEN=

# Optional assertion that prevents accidentally using a token for another account.
BUNDLED_FIREBASE_UID=
